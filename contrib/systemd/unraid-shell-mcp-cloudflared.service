[Unit]
Description=unraid-shell-mcp-cloudflared - optional Cloudflare tunnel for unraid-shell-mcp
After=network.target unraid-shell-mcp.service
Documentation=https://github.com/10bn/unraid-shell-mcp

[Service]
Type=simple
Environment=UNRAID_SHELL_MCP_BINARY=/usr/local/bin/unraid-shell-mcp
Environment=UNRAID_SHELL_MCP_CONFIG=/etc/unraid-shell-mcp/config.json
Environment=CLOUDFLARED_BINARY=/usr/local/bin/cloudflared
ExecStart=/usr/local/bin/unraid-shell-mcp-cloudflared
Restart=on-failure
RestartSec=5
User=root

# install.sh generates this same unit inline (with Environment= lines
# matching the actual install's INSTALL_DIR/CONFIG_DIR); this copy is kept
# for reference and for anyone customizing the service by hand.
#
# tunnelMode "off" (the default) makes the wrapper script exit cleanly with
# no tunnel started; this unit is safe to enable unconditionally.

[Install]
WantedBy=multi-user.target
