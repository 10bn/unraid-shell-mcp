[Unit]
Description=unraid-shell-mcp - MCP server for whitelisted shell command execution
After=network.target
Documentation=https://github.com/10bn/unraid-shell-mcp

[Service]
Type=simple
ExecStart=/usr/local/bin/unraid-shell-mcp -config /etc/unraid-shell-mcp/config.json
Restart=on-failure
RestartSec=2
User=root

# install.sh generates this same unit inline; this copy is kept for reference
# and for anyone customizing the service by hand instead of using the script.

[Install]
WantedBy=multi-user.target
