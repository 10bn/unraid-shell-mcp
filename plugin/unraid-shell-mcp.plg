<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name        "unraid-shell-mcp">
<!ENTITY author      "10bn">
<!ENTITY version     "2026.07.24">
<!ENTITY launch      "Settings/UnraidShellMcp">
<!ENTITY repo        "10bn/unraid-shell-mcp">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/&repo;/main/plugin/&name;.plg">
<!ENTITY releaseURL  "https://github.com/&repo;/releases/download/v&version;">
<!ENTITY plgNAME     "&name;-&version;-x86_64-1">
<!ENTITY plgPATH     "/boot/config/plugins/&name;">
<!ENTITY emhttp      "/usr/local/emhttp/plugins/&name;">
<!ENTITY cfPath      "/usr/local/sbin/cloudflared">
<!ENTITY cfURL       "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64">
<!ENTITY rcMCP       "/etc/rc.d/rc.&name;">
<!ENTITY rcCF        "/etc/rc.d/rc.&name;-cloudflared">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="terminal" min="6.9.0">

<CHANGES>
##&name;
###2026.07.24
- Switch to date-based versioning (YYYY.MM.DD, with an a/b/... suffix if
  there's ever a second release on the same day). Unraid's plugin manager
  compares versions as plain strings, which silently skipped the
  0.1.9 &#8594; 0.1.10 update under the old numeric scheme; date versions
  always compare correctly. Every date version also sorts above every old
  0.1.x version, so updating from any previous release — including anyone
  still stuck on 0.1.9 — works through the normal update path again, no
  forced install needed.
###0.1.12
- Docs/UI accuracy pass, no behavior changes to the server or tunnel:
  the Settings page and README both wrongly said the MCP server is
  reachable "on your LAN" with the tunnel off — it listens on 127.0.0.1
  by default, so it's only reachable from the Unraid box itself (or
  through a tunnel) unless you change listenAddr yourself; both now say
  so, and explain how. Also fixed the self-contradictory "All four run
  cloudflared (except Off)" wording, removed the README's stale claim
  that the Settings page uses Unraid's built-in per-field help icons
  (that approach was reverted in 0.1.10), refreshed the README's "Known
  limitations" to reflect that packaging and the authorized tunnel mode
  have since been verified on a real Unraid 7.3.2 server, and documented
  Unraid plugin manager's strcmp version comparison (why the 0.1.9 →
  0.1.10/0.1.11 update was silently skipped, and the `plugin install
  &lt;url&gt; forced` workaround).
- The MCP server now reports its real release version to MCP clients and
  in its startup log line (it previously always claimed "0.1.0"
  regardless of the installed version).
###0.1.11
- Fix: authorized-tunnel mode ("local") exited immediately every time it
  was started, because the final `cloudflared tunnel run` invocation
  passed --config after the `run` subcommand instead of before it (a
  cloudflared usage requirement, not documented anywhere obvious) — the
  tunnel never actually stayed up, only the login/create/route steps
  before it ever worked. No reauthorization is needed for this fix;
  existing authorization, tunnel, and DNS routing are unaffected and are
  reused as-is once you update.
###0.1.10
- Fix: the 0.1.9 "native inline-help" conversion of the Settings page did
  not actually render on a real Unraid server — the raw dynamix template
  syntax showed up as literal visible text instead of being turned into a
  form with help icons. Reverted to plain, always-visible explanatory text
  for every field (same information, guaranteed to display correctly); the
  0.1.9 Plugins-list icon fix is unaffected and stays.
- Settings page: "Allow all commands" now has its own card at the very top
  of the settings form, separate from the whitelist, with an explicit
  "Use with care, and only if you know what you're doing" line.
- Add boot-time autostart: the MCP server and (if configured) the
  Cloudflare tunnel now come back up on their own after a reboot, via a
  new event/started script that Unraid's emhttp_event runs once the array
  has finished starting. Previously both had to be started by hand from
  the Settings page after every reboot.
###0.1.9
- Settings page: replaced the custom "?" help buttons with Unraid's own
  built-in inline-help convention (dynamix form markup + a
  &lt;blockquote class="inline_help"&gt; per field, which Unraid itself turns
  into a clickable help icon), instead of a bespoke toggle this plugin
  implemented on its own. Same explanations, native mechanism.
- Add a proper icon to the Plugins page's installed-plugins list (was
  showing a generic placeholder there before) via the documented
  &lt;PLUGIN icon="..."&gt; attribute, matching the icon already used next to
  its name in the Settings menu.
###0.1.8
- Settings page: show a clear "Authorized. Finishing tunnel setup..."
  message for authorized-tunnel mode once you've approved the Cloudflare
  authorization but before the tunnel is fully up (creating the tunnel and
  routing the hostname to it), instead of leaving that short window blank.
  The auto-refresh now covers this window too, so the final Public URL
  appears on its own here as well.
- Settings page: added inline help ("?") toggles throughout explaining the
  bearer token, rotating it, the whitelist's full-match requirement, the
  allowAllCommands opt-in, the blacklist, the three tunnel modes, and the
  status badges — collapsed by default so the page stays uncluttered,
  expandable on demand.
- Settings page: added "Load example whitelist"/"Load example blacklist"
  buttons that fill in a curated starting-point set of safe, read-only
  commands (uptime, docker ps/logs/inspect, array/disk status, SMART data,
  etc.) and common explicit denials (reboot, poweroff, docker rm/stop,
  passwd, etc.) — a template to adapt, not applied until you Save
  settings. The same template is now also in config.example.json.
- Settings page: added an explicit, detailed explanation of exactly what
  the hard-coded safety blocklist covers (raw block-device writes via dd/
  redirection/tee/cp/install/rsync/dcfldd, mkfs/wipefs/shred/blkdiscard,
  destructive mdcmd array commands, rm -rf / including long-form flags,
  fork bombs) and that it can never be disabled or overridden.
###0.1.7
- Settings page: the Remote access section now shows only the fields that
  apply to the selected tunnel mode (hostname/token fields and their
  explanations hide and show as you change the dropdown, no page reload
  needed) instead of always showing all of them.
- Settings page: the hostname field now says explicitly that it wants the
  full hostname (subdomain + root domain, e.g. mcp.example.com), not just
  the subdomain part.
- Settings page: while an authorized-tunnel is starting up and the
  "Authorize with Cloudflare" link hasn't appeared yet, the page now
  refreshes itself a few times automatically so the link shows up on its
  own instead of requiring a manual reload.
- Fix: the composed "Public URL" / full MCP URL shown on the Settings page
  never reflected the configured hostname for managed ("named") tunnel
  mode, always falling back to the internal listen address instead. It now
  shows the configured hostname there too.
###0.1.6
- Add a third Cloudflare tunnel mode: "Authorized tunnel" (tunnelMode
  "local"). Enter the hostname you want, start the tunnel, and click the
  "Authorize with Cloudflare" link that appears on the Settings page — no
  Cloudflare dashboard setup needed. Behind the scenes this runs
  `cloudflared tunnel login`, then `tunnel create` and `tunnel route dns`
  itself, persisting cloudflared's own state under this plugin's config
  directory so it survives reboots. The existing "Managed tunnel" (paste a
  token from the dashboard yourself) is unchanged and still available for
  anyone who prefers to keep tunnel config centralized there.
###0.1.5
- Security: closed two hard-blocklist gaps found in a follow-up review.
  The "recursive force delete of root" rule only recognized short combined
  flags (-rf, -fr, ...); `rm --recursive --force /` (GNU long options, any
  order) passed through unblocked. Raw block-device writes via `tee`,
  `cp`, `install`, `rsync`, and `dcfldd` were also uncovered (only
  dd/redirection/mkfs/wipefs/shred/blkdiscard were). Both are now blocked
  regardless of flag form or order. This matters most whenever
  allowAllCommands is enabled, since the hard blocklist is then the only
  remaining defense.
- Security: fixed a GitHub Actions script-injection pattern in the release
  workflow (a workflow_dispatch input was interpolated directly into a
  shell script instead of passed through env). Doesn't affect the running
  plugin, only how releases are built.
- Settings page: visual redesign — card-style sections, a status badge for
  the MCP server/tunnel (running/stopped), and a small icon next to the
  plugin title. No functional changes: every field, button, and form still
  does exactly what it did before.
###0.1.4
- Fix: every request forwarded through the Cloudflare tunnel (quick or
  named) was silently rejected with 403 Forbidden. The MCP library's
  built-in DNS-rebinding protection rejects loopback-arriving requests
  whose Host header isn't a localhost value; cloudflared preserves the
  original public hostname when it forwards to our 127.0.0.1 listener, so
  every tunneled request tripped it. This is why remote MCP clients (e.g.
  ChatGPT connectors) could not connect at all. The real access control
  here is the bearer/path token, not the Host header, so this check is now
  disabled for this server.
###0.1.3
- Simplify the "allow all commands" toggle: no confirmation pop-up on save
  and no startup log warning anymore. The checkbox still works exactly the
  same otherwise, including the hard blocklist and commandBlacklist still
  applying regardless.
###0.1.2
- Fix: the bearer token on the Settings page was invisible (light text on a
  light background, unreadable in Unraid's dark theme) — not missing, just
  unreadable.
- Add a second, URL-embedded way to authenticate MCP requests
  (.../mcp/TOKEN, no header needed) for clients whose UI only accepts a
  URL. The Settings page now shows this exact URL, pre-composed with the
  active tunnel hostname and token, ready to paste.
###0.1.1
- Fix: Settings page forms were missing the webGUI's csrf_token, causing
  Unraid to silently reject every Save/Start/Stop/Rotate submission (blank
  page, nothing applied). All forms now include it.
###0.1.0
- Initial release: MCP server exposing a fail-closed, whitelisted execute-command
  tool over bearer-token-authenticated HTTP, with optional cloudflared tunnel
  (quick or named) for remote access.
</CHANGES>

<!--
The compiled Go binary + rc.d scripts + webGUI page, packaged as a standard
Slackware .txz. Only re-downloaded when missing or when its MD5 no longer
matches (Unraid's plugin installer skips the download otherwise), so this is
cheap to re-run on every boot.
-->
<FILE Name="&plgPATH;/&plgNAME;.txz">
<URL>&releaseURL;/&plgNAME;.txz</URL>
</FILE>

<FILE Name="&plgPATH;/&plgNAME;.txz.md5">
<URL>&releaseURL;/&plgNAME;.txz.md5</URL>
</FILE>

<!--
The 'install' script. Unraid re-runs this on every boot (the running system
is rebuilt from the /boot overlay each time), so every step here must be
safe to repeat.
-->
<FILE Run="/bin/bash" Method="install">
<INLINE>
set -e

# Verify package integrity before installing anything.
sum1=$(/usr/bin/md5sum &plgPATH;/&plgNAME;.txz)
sum2=$(/usr/bin/cat &plgPATH;/&plgNAME;.txz.md5)
if [ "${sum1:0:32}" != "${sum2:0:32}" ]; then
    echo "unraid-shell-mcp: package md5 mismatch, refusing to install"
    rm -f &plgPATH;/&plgNAME;.txz &plgPATH;/&plgNAME;.txz.md5
    exit 1
fi

mkdir -p &plgPATH;
upgradepkg --install-new &plgPATH;/&plgNAME;.txz

chmod 0755 &rcMCP; &rcCF; 2>/dev/null || true

# Fetch the official cloudflared binary once; skip if already present so we
# don't hit the network on every boot.
if [ ! -x &cfPath; ]; then
    echo "unraid-shell-mcp: downloading cloudflared..."
    if curl -fsSL -o &cfPath;.tmp &cfURL;; then
        chmod 0755 &cfPath;.tmp
        mv &cfPath;.tmp &cfPath;
    else
        echo "unraid-shell-mcp: failed to download cloudflared; tunnel will be unavailable until this succeeds"
        rm -f &cfPath;.tmp
    fi
fi

# Config.json (bearer token, whitelist, tunnel settings) is created with a
# fresh random token on first run only; the binary never overwrites an
# existing config file.
&rcMCP; start
&rcCF; start

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been installed."
echo " Configure it at Settings -> Unraid Shell MCP."
echo " WARNING: this exposes shell access to this NAS (array, Docker,"
echo " VMs, shares) to anyone holding the bearer token. Configure the"
echo " command whitelist and use Cloudflare Access before exposing it"
echo " remotely."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
&rcCF; stop 2>/dev/null || true
&rcMCP; stop 2>/dev/null || true

removepkg &plgPATH;/&plgNAME;.txz 2>/dev/null || true
rm -f &plgPATH;/&plgNAME;.txz &plgPATH;/&plgNAME;.txz.md5
rm -rf &emhttp;
rm -f &cfPath;

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo " Its configuration (bearer token, whitelist) was left in place"
echo " at &plgPATH;/config.json in case you reinstall. Delete it"
echo " manually if you want a clean uninstall."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
