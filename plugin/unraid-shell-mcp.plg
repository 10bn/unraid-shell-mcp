<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name        "unraid-shell-mcp">
<!ENTITY author      "10bn">
<!ENTITY version     "2026.07.25">
<!ENTITY launch      "Settings/UnraidShellMcp">
<!ENTITY repo        "10bn/unraid-shell-mcp">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/&repo;/main/plugin/&name;.plg">
<!ENTITY releaseURL  "https://github.com/&repo;/releases/download/v&version;">
<!ENTITY plgNAME     "&name;-&version;-x86_64-1">
<!ENTITY plgPATH     "/boot/config/plugins/&name;">
<!ENTITY emhttp      "/usr/local/emhttp/plugins/&name;">
<!ENTITY cfPath      "/usr/local/sbin/cloudflared">
<!ENTITY cfURL       "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64">
<!ENTITY rcMCP       "/etc/rc.d/rc.&name;">
<!ENTITY rcCF        "/etc/rc.d/rc.&name;-cloudflared">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="terminal" min="6.9.0">

<CHANGES>
##&name;
###2026.07.25
- First stable release (1.0). unraid-shell-mcp runs a Model Context
  Protocol server directly on Unraid, exposing a single execute-command
  tool over bearer-token-authenticated HTTP, gated by a fail-closed
  command policy. What's in it:
  - Command control: a whitelist (full-match regex), a blacklist, and a
    hard-coded blocklist for catastrophic operations (raw disk writes,
    mkfs/wipefs, array-destroying mdcmd, rm -rf /, fork bombs). Two
    deliberate opt-ins, both off by default and each its own switch:
    allowAllCommands (skip the whitelist) and disableHardBlocklist
    (remove the built-in safety net).
  - Auth: a random bearer token, presentable via Authorization header or
    embedded in the URL path, rotatable from the Settings page.
  - Remote access: an optional Cloudflare tunnel in three modes - quick
    (ephemeral), authorized (click-to-authorize, no dashboard), or managed
    (dashboard token). Tunnel names are derived per host, so several
    servers can share one Cloudflare account.
  - Settings page: live status, per-service start-at-boot toggles, and
    example whitelist/blacklist templates. Boots services back up on their
    own after a reboot via event/started.
  - Safety/ops: output capped per stream, every invocation audit-logged as
    a JSON line, config stored 0600 and never served unauthenticated.
</CHANGES>

<!--
The compiled Go binary + rc.d scripts + webGUI page, packaged as a standard
Slackware .txz. Only re-downloaded when missing or when its MD5 no longer
matches (Unraid's plugin installer skips the download otherwise), so this is
cheap to re-run on every boot.
-->
<FILE Name="&plgPATH;/&plgNAME;.txz">
<URL>&releaseURL;/&plgNAME;.txz</URL>
</FILE>

<FILE Name="&plgPATH;/&plgNAME;.txz.md5">
<URL>&releaseURL;/&plgNAME;.txz.md5</URL>
</FILE>

<!--
The 'install' script. Unraid re-runs this on every boot (the running system
is rebuilt from the /boot overlay each time), so every step here must be
safe to repeat.
-->
<FILE Run="/bin/bash" Method="install">
<INLINE>
set -e

# Verify package integrity before installing anything.
sum1=$(/usr/bin/md5sum &plgPATH;/&plgNAME;.txz)
sum2=$(/usr/bin/cat &plgPATH;/&plgNAME;.txz.md5)
if [ "${sum1:0:32}" != "${sum2:0:32}" ]; then
    echo "unraid-shell-mcp: package md5 mismatch, refusing to install"
    rm -f &plgPATH;/&plgNAME;.txz &plgPATH;/&plgNAME;.txz.md5
    exit 1
fi

mkdir -p &plgPATH;
upgradepkg --install-new &plgPATH;/&plgNAME;.txz

# Package files from older versions otherwise pile up on the boot USB
# forever (one .txz per update, ~2.5 MB each); keep only the version just
# installed.
for f in &plgPATH;/&name;-*-x86_64-1.txz; do
    if [ -e "$f" ]; then
        if [ "$f" != "&plgPATH;/&plgNAME;.txz" ]; then
            rm -f "$f" "$f.md5"
        fi
    fi
done

chmod 0755 &rcMCP; &rcCF; 2>/dev/null || true

# Fetch the official cloudflared binary once; skip if already present so we
# don't hit the network on every boot.
if [ ! -x &cfPath; ]; then
    echo "unraid-shell-mcp: downloading cloudflared..."
    if curl -fsSL -o &cfPath;.tmp &cfURL;; then
        chmod 0755 &cfPath;.tmp
        mv &cfPath;.tmp &cfPath;
    else
        echo "unraid-shell-mcp: failed to download cloudflared; tunnel will be unavailable until this succeeds"
        rm -f &cfPath;.tmp
    fi
fi

# Config.json (bearer token, whitelist, tunnel settings) is created with a
# fresh random token on first run only; the binary never overwrites an
# existing config file.
&rcMCP; start
&rcCF; start

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been installed."
echo " Configure it at Settings -> Unraid Shell MCP."
echo " WARNING: this exposes shell access to this NAS (array, Docker,"
echo " VMs, shares) to anyone holding the bearer token. Configure the"
echo " command whitelist and use Cloudflare Access before exposing it"
echo " remotely."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
&rcCF; stop 2>/dev/null || true
&rcMCP; stop 2>/dev/null || true

removepkg &plgPATH;/&plgNAME;.txz 2>/dev/null || true
rm -f &plgPATH;/&plgNAME;.txz &plgPATH;/&plgNAME;.txz.md5
rm -rf &emhttp;
rm -f &cfPath;

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo " Its configuration (bearer token, whitelist) was left in place"
echo " at &plgPATH;/config.json in case you reinstall. Delete it"
echo " manually if you want a clean uninstall."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
