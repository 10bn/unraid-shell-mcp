#!/bin/bash
#
# rc.unraid-shell-mcp - start/stop/restart the unraid-shell-mcp MCP server.
#
# Classic Slackware-style init script. Installed to /etc/rc.d/rc.unraid-shell-mcp
# by the plugin package's doinst.sh, which also sets the executable bit.

BINARY="/usr/local/sbin/unraid-shell-mcp"
CONFIG="/boot/config/plugins/unraid-shell-mcp/config.json"
PIDFILE="/var/run/unraid-shell-mcp.pid"
LOGFILE="/var/log/unraid-shell-mcp.log"

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "unraid-shell-mcp is already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    if [ ! -x "$BINARY" ]; then
        echo "unraid-shell-mcp binary not found at $BINARY"
        return 1
    fi
    echo "Starting unraid-shell-mcp..."
    nohup "$BINARY" -config "$CONFIG" >>"$LOGFILE" 2>&1 &
    echo $! >"$PIDFILE"
    disown
}

stop() {
    if [ ! -f "$PIDFILE" ]; then
        echo "unraid-shell-mcp is not running (no pid file)"
        return 0
    fi
    local pid
    pid="$(cat "$PIDFILE")"
    if kill -0 "$pid" 2>/dev/null; then
        echo "Stopping unraid-shell-mcp (pid $pid)..."
        kill "$pid"
        for _ in $(seq 1 10); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "unraid-shell-mcp is running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "unraid-shell-mcp is not running"
    return 1
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
