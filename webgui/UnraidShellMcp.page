<?PHP
/* Copyright 2026, 10bn. Settings page for the unraid-shell-mcp plugin. */

$cfgFile = "/boot/config/plugins/unraid-shell-mcp/config.json";
$rcMcp   = "/etc/rc.d/rc.unraid-shell-mcp";
$rcCf    = "/etc/rc.d/rc.unraid-shell-mcp-cloudflared";
$urlFile = "/var/run/unraid-shell-mcp-cloudflared-url.txt";

function usm_load_config($path) {
    if (!file_exists($path)) {
        return null;
    }
    $data = json_decode(file_get_contents($path), true);
    return is_array($data) ? $data : null;
}

function usm_save_config($path, $cfg) {
    $json = json_encode($cfg, JSON_PRETTY_PRINT);
    $tmp = $path . ".tmp";
    file_put_contents($tmp, $json, LOCK_EX);
    chmod($tmp, 0600);
    rename($tmp, $path);
}

function usm_lines_to_list($text) {
    $lines = preg_split('/\r\n|\r|\n/', trim((string)$text));
    $out = [];
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line !== '') {
            $out[] = $line;
        }
    }
    return $out;
}

$cfg = usm_load_config($cfgFile);
$notice = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST' && $cfg !== null) {
    $action = $_POST['action'] ?? '';

    if ($action === 'save_settings') {
        $cfg['commandWhitelist'] = usm_lines_to_list($_POST['commandWhitelist'] ?? '');
        $cfg['commandBlacklist'] = usm_lines_to_list($_POST['commandBlacklist'] ?? '');
        $cfg['allowAllCommands'] = isset($_POST['allowAllCommands']);
        $tunnelMode = $_POST['tunnelMode'] ?? 'off';
        $cfg['tunnelMode'] = in_array($tunnelMode, ['off', 'quick', 'named'], true) ? $tunnelMode : 'off';
        $cfg['cloudflareTunnelToken'] = trim($_POST['cloudflareTunnelToken'] ?? '');
        $cfg['cloudflareTunnelHostname'] = trim($_POST['cloudflareTunnelHostname'] ?? '');
        usm_save_config($cfgFile, $cfg);
        $notice = "Settings saved.";
    } elseif ($action === 'rotate_token') {
        $cfg['bearerToken'] = bin2hex(random_bytes(32));
        usm_save_config($cfgFile, $cfg);
        $notice = "Bearer token rotated. Update any MCP clients with the new token below.";
    } elseif ($action === 'start_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' start 2>&1');
        $notice = "Start requested.";
    } elseif ($action === 'stop_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' stop 2>&1');
        $notice = "Stop requested.";
    } elseif ($action === 'restart_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' restart 2>&1');
        $notice = "Restart requested.";
    } elseif ($action === 'start_cf') {
        shell_exec(escapeshellarg($rcCf) . ' start 2>&1');
        $notice = "Tunnel start requested.";
    } elseif ($action === 'stop_cf') {
        shell_exec(escapeshellarg($rcCf) . ' stop 2>&1');
        $notice = "Tunnel stop requested.";
    }

    $cfg = usm_load_config($cfgFile);
}

$mcpStatus = $cfg !== null ? trim(shell_exec(escapeshellarg($rcMcp) . ' status 2>&1')) : "not configured";
$cfStatus  = $cfg !== null ? trim(shell_exec(escapeshellarg($rcCf) . ' status 2>&1')) : "not configured";
$publicUrl = file_exists($urlFile) ? trim(file_get_contents($urlFile)) : "";

$whitelistText    = $cfg !== null ? implode("\n", $cfg['commandWhitelist'] ?? []) : "";
$blacklistText    = $cfg !== null ? implode("\n", $cfg['commandBlacklist'] ?? []) : "";
$allowAllCommands = !empty($cfg['allowAllCommands']);
$tunnelMode       = $cfg['tunnelMode'] ?? 'off';
$cfToken          = $cfg['cloudflareTunnelToken'] ?? '';
$cfHostname       = $cfg['cloudflareTunnelHostname'] ?? '';
$bearerToken      = $cfg['bearerToken'] ?? '';
?>
<style>
.usm-warning {
    background: #fff3cd;
    border: 1px solid #ffe69c;
    color: #664d03;
    padding: 10px 14px;
    margin-bottom: 16px;
    border-radius: 4px;
}
.usm-notice {
    background: #d1e7dd;
    border: 1px solid #a3cfbb;
    color: #0f5132;
    padding: 8px 14px;
    margin-bottom: 16px;
    border-radius: 4px;
}
.usm-section {
    margin-bottom: 24px;
}
.usm-section h3 {
    margin-bottom: 6px;
}
textarea.usm-list {
    width: 100%;
    max-width: 640px;
    height: 120px;
    font-family: monospace;
}
.usm-token {
    font-family: monospace;
    background: #f5f5f5;
    padding: 4px 8px;
    border-radius: 4px;
    word-break: break-all;
}
.usm-danger-toggle {
    background: #f8d7da;
    border: 1px solid #f1aeb5;
    color: #58151c;
    padding: 10px 14px;
    border-radius: 4px;
}
</style>

<div class="usm-warning">
    <strong>Warning:</strong> unraid-shell-mcp executes arbitrary shell commands on this NAS
    (full array, Docker, VM, and share access) for anyone holding the bearer token below.
    Keep the command whitelist as narrow as possible and put Cloudflare Access in front of
    this service before exposing it outside your LAN.
</div>

<?php if ($notice): ?>
<div class="usm-notice"><?= htmlspecialchars($notice) ?></div>
<?php endif; ?>

<?php if ($cfg === null): ?>
<p>Configuration file not found yet. Start the service once (or reboot) to generate it.</p>
<?php else: ?>

<div class="usm-section">
    <h3>Status</h3>
    <p>MCP server: <code><?= htmlspecialchars($mcpStatus) ?></code></p>
    <p>cloudflared: <code><?= htmlspecialchars($cfStatus) ?></code></p>
    <?php if ($publicUrl): ?>
    <p>Public URL: <a href="<?= htmlspecialchars($publicUrl) ?>" target="_blank"><?= htmlspecialchars($publicUrl) ?></a></p>
    <?php endif; ?>

    <form method="post" style="display:inline">
        <input type="hidden" name="action" value="start_mcp">
        <button type="submit">Start server</button>
    </form>
    <form method="post" style="display:inline">
        <input type="hidden" name="action" value="stop_mcp">
        <button type="submit">Stop server</button>
    </form>
    <form method="post" style="display:inline">
        <input type="hidden" name="action" value="restart_mcp">
        <button type="submit">Restart server</button>
    </form>
    <form method="post" style="display:inline">
        <input type="hidden" name="action" value="start_cf">
        <button type="submit">Start tunnel</button>
    </form>
    <form method="post" style="display:inline">
        <input type="hidden" name="action" value="stop_cf">
        <button type="submit">Stop tunnel</button>
    </form>
</div>

<div class="usm-section">
    <h3>Bearer token</h3>
    <p>Present this as <code>Authorization: Bearer &lt;token&gt;</code> on every MCP request.</p>
    <p class="usm-token"><?= htmlspecialchars($bearerToken) ?></p>
    <form method="post" onsubmit="return confirm('Rotate the bearer token? Existing MCP clients will need the new token.');">
        <input type="hidden" name="action" value="rotate_token">
        <button type="submit">Rotate token</button>
    </form>
</div>

<form method="post" onsubmit="return !document.getElementById('allowAllCommands').checked || confirm('Enable \'allow all commands\'? Every command becomes eligible to run except the hard-coded safety blocklist and your commandBlacklist — the whitelist below stops being enforced. Anyone holding the bearer token gets full shell access. Continue?');">
<input type="hidden" name="action" value="save_settings">

<div class="usm-section">
    <h3>Command whitelist</h3>
    <p>One regular expression per line. A command must match at least one line <em>in full</em>
       (not just a prefix) to be eligible to run. <strong>An empty whitelist blocks all
       commands</strong> &mdash; there is no "allow everything" fallback, unless you explicitly
       enable the option below.</p>
    <textarea class="usm-list" name="commandWhitelist"><?= htmlspecialchars($whitelistText) ?></textarea>
    <p class="usm-danger-toggle">
        <label>
            <input type="checkbox" id="allowAllCommands" name="allowAllCommands" <?= $allowAllCommands ? 'checked' : '' ?>>
            <strong>Allow all commands</strong> &mdash; bypasses the whitelist above entirely.
            The hard-coded safety blocklist and the command blacklist below still apply, but
            everything else is permitted. This is a deliberate, explicit opt-in with a full
            shell blast radius; leave it unchecked unless you specifically need it (e.g. local
            testing). A loud warning is logged on every server start while this is enabled.
        </label>
    </p>
</div>

<div class="usm-section">
    <h3>Command blacklist</h3>
    <p>One regular expression per line. Checked in addition to a hard-coded, non-configurable
       safety blocklist (raw disk writes, array-destructive commands, <code>rm -rf /</code>,
       etc.) that always applies regardless of the whitelist.</p>
    <textarea class="usm-list" name="commandBlacklist"><?= htmlspecialchars($blacklistText) ?></textarea>
</div>

<div class="usm-section">
    <h3>Remote access</h3>
    <p>Tunnel mode:
        <select name="tunnelMode">
            <option value="off" <?= $tunnelMode === 'off' ? 'selected' : '' ?>>Off</option>
            <option value="quick" <?= $tunnelMode === 'quick' ? 'selected' : '' ?>>Quick tunnel (ephemeral trycloudflare.com URL, no account needed)</option>
            <option value="named" <?= $tunnelMode === 'named' ? 'selected' : '' ?>>Named tunnel (stable hostname via Cloudflare Zero Trust)</option>
        </select>
    </p>
    <p>Cloudflare tunnel token (Zero Trust dashboard, named mode only):<br>
        <input type="password" name="cloudflareTunnelToken" value="<?= htmlspecialchars($cfToken) ?>" style="width:100%;max-width:640px;font-family:monospace">
    </p>
    <p>Cloudflare tunnel hostname (named mode only):<br>
        <input type="text" name="cloudflareTunnelHostname" value="<?= htmlspecialchars($cfHostname) ?>" style="width:100%;max-width:640px;font-family:monospace" placeholder="mcp.example.com">
    </p>
</div>

<button type="submit">Save settings</button>
</form>

<?php endif; ?>
