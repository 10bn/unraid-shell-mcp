<?PHP
/* Copyright 2026, 10bn. Settings page for the unraid-shell-mcp plugin. */

$cfgFile      = "/boot/config/plugins/unraid-shell-mcp/config.json";
$rcMcp        = "/etc/rc.d/rc.unraid-shell-mcp";
$rcCf         = "/etc/rc.d/rc.unraid-shell-mcp-cloudflared";
$urlFile      = "/var/run/unraid-shell-mcp-cloudflared-url.txt";
$loginUrlFile = "/var/run/unraid-shell-mcp-cloudflared-login-url.txt";

function usm_load_config($path) {
    if (!file_exists($path)) {
        return null;
    }
    $data = json_decode(file_get_contents($path), true);
    return is_array($data) ? $data : null;
}

function usm_save_config($path, $cfg) {
    $json = json_encode($cfg, JSON_PRETTY_PRINT);
    $tmp = $path . ".tmp";
    file_put_contents($tmp, $json, LOCK_EX);
    chmod($tmp, 0600);
    rename($tmp, $path);
}

function usm_lines_to_list($text) {
    $lines = preg_split('/\r\n|\r|\n/', trim((string)$text));
    $out = [];
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line !== '') {
            $out[] = $line;
        }
    }
    return $out;
}

// Unraid's webGUI rejects any POST that doesn't carry the session's current
// csrf_token (silently, as a blank page) — $var is populated by the page
// wrapper that includes this file, before our code runs.
$csrfToken = isset($var['csrf_token']) ? $var['csrf_token'] : '';

$cfg = usm_load_config($cfgFile);
$notice = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST' && $cfg !== null) {
    $action = $_POST['action'] ?? '';

    if ($action === 'save_settings') {
        $cfg['commandWhitelist'] = usm_lines_to_list($_POST['commandWhitelist'] ?? '');
        $cfg['commandBlacklist'] = usm_lines_to_list($_POST['commandBlacklist'] ?? '');
        $cfg['allowAllCommands'] = isset($_POST['allowAllCommands']);
        $cfg['disableHardBlocklist'] = isset($_POST['disableHardBlocklist']);
        $cfg['autostartMcp'] = isset($_POST['autostartMcp']);
        $cfg['autostartTunnel'] = isset($_POST['autostartTunnel']);
        $tunnelMode = $_POST['tunnelMode'] ?? 'off';
        $cfg['tunnelMode'] = in_array($tunnelMode, ['off', 'quick', 'named', 'local'], true) ? $tunnelMode : 'off';
        $cfg['cloudflareTunnelToken'] = trim($_POST['cloudflareTunnelToken'] ?? '');
        $cfg['cloudflareTunnelHostname'] = trim($_POST['cloudflareTunnelHostname'] ?? '');
        usm_save_config($cfgFile, $cfg);
        $notice = "Settings saved.";
    } elseif ($action === 'rotate_token') {
        $cfg['bearerToken'] = bin2hex(random_bytes(32));
        usm_save_config($cfgFile, $cfg);
        $notice = "Bearer token rotated. Update any MCP clients with the new token below.";
    } elseif ($action === 'start_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' start 2>&1');
        $notice = "Start requested.";
    } elseif ($action === 'stop_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' stop 2>&1');
        $notice = "Stop requested.";
    } elseif ($action === 'restart_mcp') {
        shell_exec(escapeshellarg($rcMcp) . ' restart 2>&1');
        $notice = "Restart requested.";
    } elseif ($action === 'start_cf') {
        shell_exec(escapeshellarg($rcCf) . ' start 2>&1');
        $notice = "Tunnel start requested.";
    } elseif ($action === 'stop_cf') {
        shell_exec(escapeshellarg($rcCf) . ' stop 2>&1');
        $notice = "Tunnel stop requested.";
    }

    $cfg = usm_load_config($cfgFile);
}

$mcpStatus = $cfg !== null ? trim((string)shell_exec(escapeshellarg($rcMcp) . ' status 2>&1')) : "not configured";
$cfStatus  = $cfg !== null ? trim((string)shell_exec(escapeshellarg($rcCf) . ' status 2>&1')) : "not configured";
$publicUrl = file_exists($urlFile) ? trim(file_get_contents($urlFile)) : "";
$loginUrl  = file_exists($loginUrlFile) ? trim(file_get_contents($loginUrlFile)) : "";

$whitelistText    = $cfg !== null ? implode("\n", $cfg['commandWhitelist'] ?? []) : "";
$blacklistText    = $cfg !== null ? implode("\n", $cfg['commandBlacklist'] ?? []) : "";
$allowAllCommands = !empty($cfg['allowAllCommands']);
$disableHardBlocklist = !empty($cfg['disableHardBlocklist']);
// Default to enabled when the field is absent (config predating the
// autostart toggles), matching how the Go side and event/started treat it.
$autostartMcp    = $cfg !== null ? (!array_key_exists('autostartMcp', $cfg) || !empty($cfg['autostartMcp'])) : true;
$autostartTunnel = $cfg !== null ? (!array_key_exists('autostartTunnel', $cfg) || !empty($cfg['autostartTunnel'])) : true;
$tunnelMode       = $cfg['tunnelMode'] ?? 'off';
$cfToken          = $cfg['cloudflareTunnelToken'] ?? '';
$cfHostname       = $cfg['cloudflareTunnelHostname'] ?? '';
$bearerToken      = $cfg['bearerToken'] ?? '';

// Managed ("named") mode never writes urlFile — cloudflared learns its
// ingress/hostname entirely from the dashboard-issued token, so the rc.d
// script has nothing to write there. Fall back to the hostname the operator
// entered here (display-only; it isn't otherwise used for that mode) so the
// composed MCP URL below still reflects the actual public endpoint instead
// of always showing the internal listenAddr for anyone using managed mode.
if ($publicUrl === "" && $tunnelMode === 'named' && $cfHostname !== "") {
    $publicUrl = "https://" . $cfHostname;
}

// A single ready-to-paste URL for MCP clients that only accept a URL and
// have no way to configure a custom Authorization header: the bearer token
// travels in the path instead of a header (see internal/auth.PathTokenMiddleware).
$mcpBaseUrl = $publicUrl !== "" ? rtrim($publicUrl, "/") : "http://" . ($cfg['listenAddr'] ?? "127.0.0.1:8483");
$fullMcpUrl = ($cfg !== null && !empty($cfg['bearerToken'])) ? $mcpBaseUrl . "/mcp/" . $cfg['bearerToken'] : "";

// Presentation-only: which badge color the Status card shows. Matched
// against the literal phrase rc.d's status() function prints — "is not
// running" does *not* contain "is running" as a substring (the "not "
// breaks it), so this reliably distinguishes the two without needing to
// change how status is captured (shell_exec gives us stdout only, no exit
// code).
$mcpRunning = strpos($mcpStatus, ' is running') !== false;
$cfRunning  = strpos($cfStatus, ' is running') !== false;
?>
