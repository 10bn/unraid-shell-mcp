<script>
function usmLoadExample(textareaId, exampleId) {
    document.getElementById(textareaId).value = document.getElementById(exampleId).textContent.trim();
}
function usmUpdateTunnelFields() {
    var mode = document.getElementById('usmTunnelMode').value;
    document.querySelectorAll('[data-usm-modes]').forEach(function (el) {
        var modes = el.getAttribute('data-usm-modes').split(' ');
        el.style.display = modes.indexOf(mode) !== -1 ? '' : 'none';
    });
}
usmUpdateTunnelFields();
</script>

