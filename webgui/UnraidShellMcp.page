// Auto-refresh while an authorized-mode tunnel is between "just started"
// and "fully up", so whichever of the two things worth seeing — the
// authorization link, or the finished Public URL — appears on its own
// instead of requiring a manual reload. Once either shows up there's
// something for the operator to look at (either "go authorize" or "it's
// done"), so this deliberately keeps polling through the create/route
// window in between even though status already reports "running" there
// (the tracked pid is alive throughout login/create/route/run alike, so
// $cfRunning alone can't distinguish "still setting up" from "actually
// serving" — only $publicUrl being set means the latter). It does NOT
// refresh once $loginUrl is showing, since that's an indefinite wait on a
// human, not something to poll for. Bounded via a query-string counter so
// this can never loop forever if something's genuinely stuck rather than
// just still starting up.
if ($tunnelMode === 'local' && $loginUrl === '' && $publicUrl === '') {
    $usmWait = isset($_GET['_usmwait']) ? (int) $_GET['_usmwait'] : 0;
    if ($usmWait < 10) {
        $usmNextWait = $usmWait + 1;
        echo "<script>setTimeout(function(){ var u = new URL(location.href); u.searchParams.set('_usmwait', '$usmNextWait'); location.href = u.toString(); }, 2000);</" . "script>";
    }
}
?>

<?php endif; ?>
